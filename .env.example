NODE_ENV=production
PORT=5177
PUBLIC_BASE_URL=https://recruit.example.com
STORAGE_DRIVER=mysql
MYSQL_PASSWORD=replace-with-strong-app-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_URL=mysql://hr_app:replace-with-strong-password@mysql:3306/hr_resume
MYSQL_SSL=false
MYSQL_AUTO_MIGRATE=false
MYSQL_POOL_SIZE=10
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_TTL_SECONDS=7200
JWT_ISSUER=hr-resume-system
JWT_AUDIENCE=hr-resume-admin
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=10
BODY_LIMIT_BYTES=1048576
TRUST_PROXY=true
RUN_BACKGROUND_JOBS=true
PDF_PYTHON=python3
PDF_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
REPORTS_DIR=/app/data/reports
APT_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
